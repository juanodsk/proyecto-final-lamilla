generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  STUDENT
  AGENT
}
enum Campus {
  CENTRAL
  NORTE
}
enum Category {
  ACCESS
  ENROLLMENT
  CAMPUS
  OTHER
}
enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role
  campus Campus
  tickets Ticket[]
}
model Ticket {
  id String @id @default(uuid())
  title String
  description String
  category Category
  status Status @default(OPEN)
  campus Campus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  notifications Notification[]
  @@index([ownerId, createdAt])
  @@index([campus, createdAt])
}
model OutboxEvent {
  id String @id @default(uuid())
  ticketId String
  status Status
  createdAt DateTime @default(now())
  processedAt DateTime?
  notification Notification?
  @@index([processedAt, createdAt])
}
model Notification {
  id String @id @default(uuid())
  eventId String @unique
  event OutboxEvent @relation(fields: [eventId], references: [id])
  ticketId String
  ticket Ticket @relation(fields: [ticketId], references: [id])
  status Status
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}
